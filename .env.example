# Copy to .env and adjust. The server reads these at startup.
HOST=127.0.0.1
PORT=3000

# Optional. When set, all /api/* requests require
# Authorization: Bearer <token>  OR  ?token=<token>
VILLAGE_API_TOKEN=

# Provider selection. If unset, the server picks the first configured one,
# falling back to "mock" (deterministic, no network).
VILLAGE_PROVIDER=

# OpenAI-compatible
OPENAI_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama
OLLAMA_BASE=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Anthropic
ANTHROPIC_BASE=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Stable Diffusion adapter (only used by sd_generate, always approval-gated)
SD_ENDPOINT=

# HMAC key for signed exports. CHANGE THIS IN PRODUCTION.
VILLAGE_EXPORT_SECRET=
